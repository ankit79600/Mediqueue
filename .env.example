# =============================================================================
# MediQueue — Root environment variable reference
# Copy this file to .env and fill in real values.
# NEVER commit .env — it contains secrets.
# This .env.example file is safe to commit (all values are placeholders).
#
# How values are organized:
#   [SECRET]  — must be kept private; never put in frontend code or version control
#   [PUBLIC]  — safe to expose; can be in frontend bundles or public config
#   [DEPLOY]  — set this on the hosting provider (Render / Vercel / Neon)
#   [LOCAL]   — set this in your local .env file only
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE
# [SECRET] [DEPLOY] [LOCAL]
# Paste your Neon / Supabase / local docker-compose connection string here.
# Production: set DATABASE_URL directly on Render (never in .env committed to git).
# Local: docker-compose postgres runs at localhost:5432 (see docker-compose.yml).
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mq:mq@localhost:5432/mediqueue

# ─────────────────────────────────────────────────────────────────────────────
# SERVER
# [PUBLIC] [LOCAL] [DEPLOY]
# ─────────────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# JWT
# [SECRET] [LOCAL] [DEPLOY]
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# JWT_SECRET must NEVER appear in any frontend file or VITE_ variable.
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_TTL_PATIENT=12h
JWT_TTL_STAFF=12h

# ─────────────────────────────────────────────────────────────────────────────
# OTP
# [SECRET] [LOCAL] [DEPLOY]
# Pepper string mixed with the OTP code before SHA-256 hashing.
# Generate the same way as JWT_SECRET (random hex, 64+ chars).
# ─────────────────────────────────────────────────────────────────────────────
OTP_PEPPER=

# ─────────────────────────────────────────────────────────────────────────────
# QR / TRACK URL
# [SECRET] [LOCAL] [DEPLOY]
# HMAC-SHA256 key used to sign the public tracking URL (/t/:id?s=<sig>).
# If an attacker learns QR_SECRET they can forge tracking links.
# ─────────────────────────────────────────────────────────────────────────────
QR_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# KIOSK KEY
# [SECRET] server-side | [PUBLIC] kiosk frontend build only
# Sent as the X-Kiosk-Key header by the kiosk UI.
# On the server: validated by requireKioskKey middleware.
# On the frontend: exposed only in kiosk builds via VITE_KIOSK_KEY (see apps/web/.env.example).
# ─────────────────────────────────────────────────────────────────────────────
KIOSK_KEY=kiosk-demo-key

# ─────────────────────────────────────────────────────────────────────────────
# DEMO MODE
# [PUBLIC] [LOCAL] [DEPLOY]
# true  → OTP response includes devOtp field (shown as "SMS simulated" toast)
#         and enables the POST /admin/demo/reset endpoint.
# false → devOtp is omitted; /admin/demo/reset returns 403.
# Set to false in any production build not intended for hackathon judging.
# ─────────────────────────────────────────────────────────────────────────────
DEMO_MODE=true

# ─────────────────────────────────────────────────────────────────────────────
# SMS
# [PUBLIC] [LOCAL] [DEPLOY]
# simulated → OTP and notifications written to the DB only; no real SMS sent.
# twilio    → real SMS via Twilio (requires TWILIO_* vars below).
# Default is simulated — Twilio credentials are NOT required for this project.
# ─────────────────────────────────────────────────────────────────────────────
SMS_MODE=simulated

# Twilio — only needed when SMS_MODE=twilio (not required for hackathon/demo)
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# HOSPITAL
# [PUBLIC] [LOCAL] [DEPLOY]
# Timezone used to compute service_date from UTC timestamps.
# ─────────────────────────────────────────────────────────────────────────────
HOSPITAL_TZ=Asia/Kolkata

# ─────────────────────────────────────────────────────────────────────────────
# URLS
# [PUBLIC] [LOCAL] [DEPLOY]
# PUBLIC_WEB_URL: base URL of the deployed frontend — used to build the QR
#   tracking link embedded in token tickets (e.g. https://mediqueue.vercel.app).
# CORS_ORIGIN: Express CORS whitelist — must match the actual frontend URL.
# Update both when you deploy to Vercel.
# ─────────────────────────────────────────────────────────────────────────────
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# ML MODEL
# [PUBLIC] [LOCAL] [DEPLOY]
# Path to the trained model file (relative to apps/server/src).
# If the file is missing the server falls back to the AVG ETA formula automatically.
# ─────────────────────────────────────────────────────────────────────────────
ML_MODEL_PATH=../../ml/model.json

# ─────────────────────────────────────────────────────────────────────────────
# ETA TICK
# [PUBLIC] [LOCAL] [DEPLOY]
# How often (ms) the server recalculates ETAs even without queue mutations (T7).
# ─────────────────────────────────────────────────────────────────────────────
ETA_TICK_MS=30000

# ─────────────────────────────────────────────────────────────────────────────
# SIMULATOR
# [PUBLIC] [LOCAL]
# Base URL the simulator CLI uses to call the REST API.
# ─────────────────────────────────────────────────────────────────────────────
SIMULATOR_BASE_URL=http://localhost:4000/api/v1

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND — Vite variables
# These belong in apps/web/.env; listed here for a single-file overview.
# All VITE_ vars are bundled into the client and are PUBLIC — never put secrets here.
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000
VITE_USE_MOCKS=false
VITE_KIOSK_KEY=kiosk-demo-key
