# ─── ENVIRONMENT ───────────────────────────────────────────────────────────────
# Never commit real .env files — they contain secrets (DATABASE_URL, JWT_SECRET,
# OTP_PEPPER, QR_SECRET). Only .env.example files are safe to commit.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
apps/server/.env
apps/server/.env.local
apps/web/.env
apps/web/.env.local
apps/web/.env.development.local
apps/web/.env.production.local

# Always keep example files tracked
!.env.example
!apps/server/.env.example
!apps/web/.env.example

# ─── NODE ──────────────────────────────────────────────────────────────────────
node_modules/
dist/
build/
.turbo/

# ─── LOGS ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ─── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── IDE ───────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.suo
*.user

# ─── PRISMA ────────────────────────────────────────────────────────────────────
# Migrations are committed (they are the schema history).
# Generated client is not committed.
apps/server/node_modules/

# ─── ML DATA ───────────────────────────────────────────────────────────────────
# Synthetic training data is gitignored; sample is checked in.
ml/data/
!ml/data/sample.csv

# ─── COVERAGE / TEST OUTPUT ────────────────────────────────────────────────────
coverage/
.nyc_output/
