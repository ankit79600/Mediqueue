# =============================================================================
# MediQueue — Backend (apps/server) environment variables
# Copy this file to apps/server/.env and fill in real values.
# NEVER commit apps/server/.env — it contains secrets.
#
# LOCAL SETUP
#   1. cp apps/server/.env.example apps/server/.env
#   2. Fill DATABASE_URL, JWT_SECRET, OTP_PEPPER, QR_SECRET
#   3. Run: npm run db:up  (starts local Postgres via docker-compose)
#   4. Run: npm run db:migrate && npm run db:seed
#
# DEPLOYMENT (Render)
#   Set every variable marked [DEPLOY] directly in the Render dashboard.
#   Do NOT upload a .env file to Render — use environment variables UI.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE
# Type:     SECRET
# Local:    paste local docker-compose URL, or your Neon/Supabase connection string
# Deploy:   set on Render → Environment → Add environment variable
#
# docker-compose default: postgresql://mq:mq@localhost:5432/mediqueue
# Neon format:            postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mq:mq@localhost:5432/mediqueue

# ─────────────────────────────────────────────────────────────────────────────
# SERVER
# Type:     Public
# Local:    set in apps/server/.env
# Deploy:   Render sets PORT automatically; set NODE_ENV=production on Render
# ─────────────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# JWT
# Type:     SECRET
# Local:    generate once and save in apps/server/.env
# Deploy:   set on Render
#
# Generate:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# SECURITY: JWT_SECRET must NEVER appear in any VITE_ variable or frontend file.
# If leaked, all existing tokens are compromised — rotate immediately.
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_TTL_PATIENT=12h
JWT_TTL_STAFF=12h

# ─────────────────────────────────────────────────────────────────────────────
# OTP PEPPER
# Type:     SECRET
# Local:    generate once and save in apps/server/.env
# Deploy:   set on Render
#
# Mixed with the 6-digit OTP before SHA-256 hashing (stored in otp_requests.code_hash).
# If changed, all outstanding OTPs are immediately invalidated.
# Generate with the same command as JWT_SECRET.
# ─────────────────────────────────────────────────────────────────────────────
OTP_PEPPER=

# ─────────────────────────────────────────────────────────────────────────────
# QR SECRET
# Type:     SECRET
# Local:    generate once and save in apps/server/.env
# Deploy:   set on Render
#
# HMAC-SHA256 key for signing public token-tracking URLs (/t/:tokenId?s=<sig>).
# The first 16 hex chars of HMAC(QR_SECRET, tokenId) become the URL signature.
# Generate with the same command as JWT_SECRET.
# ─────────────────────────────────────────────────────────────────────────────
QR_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# KIOSK KEY
# Type:     Shared secret (server validates; kiosk frontend sends as X-Kiosk-Key header)
# Local:    set in apps/server/.env; must match VITE_KIOSK_KEY in apps/web/.env
# Deploy:   set on Render; set matching VITE_KIOSK_KEY on Vercel
#
# NOTE: Because this value is also in the kiosk frontend bundle (VITE_KIOSK_KEY),
# it is NOT a high-security secret — it only restricts kiosk endpoints from arbitrary callers.
# Use a strong random string in production kiosk deployments.
# ─────────────────────────────────────────────────────────────────────────────
KIOSK_KEY=kiosk-demo-key

# ─────────────────────────────────────────────────────────────────────────────
# DEMO MODE
# Type:     Public flag
# Local:    keep true so devOtp appears in OTP responses during development
# Deploy:   set true on Render for hackathon judging; set false for real deployments
#
# When true:
#   - E2 /auth/otp/request response includes devOtp (shown as "SMS simulated" toast)
#   - POST /admin/demo/reset endpoint is enabled
# ─────────────────────────────────────────────────────────────────────────────
DEMO_MODE=true

# ─────────────────────────────────────────────────────────────────────────────
# SMS MODE
# Type:     Public flag
# Local:    keep simulated (no Twilio account needed)
# Deploy:   keep simulated for hackathon; set twilio only if sending real SMS
#
# simulated → OTP codes logged in server console; notifications saved to DB only
# twilio    → real SMS via Twilio API (requires TWILIO_* vars below)
#
# Equivalent to SMS_ENABLED=false when set to 'simulated'.
# ─────────────────────────────────────────────────────────────────────────────
SMS_MODE=simulated

# Twilio credentials — ONLY required when SMS_MODE=twilio
# Type:     SECRET — do not commit; set on Render when SMS_MODE=twilio
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# HOSPITAL TIMEZONE
# Type:     Public
# Local:    set in apps/server/.env
# Deploy:   set on Render
#
# All UTC timestamps in the DB; service_date computed in this timezone.
# ─────────────────────────────────────────────────────────────────────────────
HOSPITAL_TZ=Asia/Kolkata

# ─────────────────────────────────────────────────────────────────────────────
# URLS
# Type:     Public
# Local:    localhost defaults work for local dev
# Deploy:   update to real deployed URLs on Render
#
# PUBLIC_WEB_URL: base URL of the deployed frontend — embedded in QR tracking links
# CORS_ORIGIN:    Express CORS whitelist — must exactly match the frontend's origin
# ─────────────────────────────────────────────────────────────────────────────
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# ML MODEL
# Type:     Public path
# Local:    relative to apps/server/src/; file generated by ml/train.py
# Deploy:   set on Render (or keep default if model.json is committed)
#
# If the file does not exist the server silently falls back to the AVG formula.
# ─────────────────────────────────────────────────────────────────────────────
ML_MODEL_PATH=../../ml/model.json

# ─────────────────────────────────────────────────────────────────────────────
# ETA TICK
# Type:     Public
# Local/Deploy: how often (ms) the server re-emits updated ETAs (Socket T7)
# ─────────────────────────────────────────────────────────────────────────────
ETA_TICK_MS=30000

# ─────────────────────────────────────────────────────────────────────────────
# SIMULATOR
# Type:     Public
# Local:    base URL for simulator CLI; must point to the running server
# Deploy:   set on Render if you run the simulator as a separate service
# ─────────────────────────────────────────────────────────────────────────────
SIMULATOR_BASE_URL=http://localhost:4000/api/v1
