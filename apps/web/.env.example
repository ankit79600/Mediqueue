# =============================================================================
# MediQueue — Frontend (apps/web) environment variables
# Copy this file to apps/web/.env and fill in real values.
# apps/web/.env is gitignored.
#
# IMPORTANT — Vite security model:
#   Every variable prefixed VITE_ is bundled into the client JavaScript and is
#   PUBLIC. Anyone who downloads the app can read these values.
#   NEVER put DATABASE_URL, JWT_SECRET, OTP_PEPPER, QR_SECRET, or any private
#   API key in this file or in any VITE_ variable.
#
# LOCAL SETUP
#   cp apps/web/.env.example apps/web/.env
#   (default values below work with the local dev server at localhost:4000)
#
# DEPLOYMENT (Vercel)
#   Set VITE_API_URL and VITE_SOCKET_URL in Vercel → Project Settings → Environment Variables.
#   Set VITE_KIOSK_KEY only for kiosk-specific deployments.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# API URL
# Type:     Public
# Local:    http://localhost:4000/api/v1
# Deploy:   https://<your-render-service>.onrender.com/api/v1
#
# Used by lib/api.js as the base URL for all REST calls.
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api/v1

# ─────────────────────────────────────────────────────────────────────────────
# SOCKET URL
# Type:     Public
# Local:    http://localhost:4000
# Deploy:   https://<your-render-service>.onrender.com
#
# Used by lib/socket.js to connect Socket.IO (path /socket.io).
# Must be the same host as VITE_API_URL but WITHOUT the /api/v1 path.
# Render supports WebSockets — no extra configuration needed.
# ─────────────────────────────────────────────────────────────────────────────
VITE_SOCKET_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────────────────────
# USE MOCKS
# Type:     Public development flag
# Local:    false when a real backend is running; true for frontend-only dev
# Deploy:   must be false on Vercel
#
# When true, lib/api.js and lib/socket.js use src/mocks/ fixtures instead of
# making real network calls. Enabled by `npm run dev:mock`.
# ─────────────────────────────────────────────────────────────────────────────
VITE_USE_MOCKS=false

# ─────────────────────────────────────────────────────────────────────────────
# KIOSK KEY
# Type:     Shared secret (kiosk build only)
# Local:    must match KIOSK_KEY in apps/server/.env
# Deploy:   set on Vercel for kiosk-specific deployments only
#
# Sent as X-Kiosk-Key header by the kiosk pages (/kiosk route).
# Because this is a VITE_ variable it is visible in the browser bundle —
# this is intentional: the kiosk is a controlled device.
# Do NOT use this variable on patient or staff pages.
# ─────────────────────────────────────────────────────────────────────────────
VITE_KIOSK_KEY=kiosk-demo-key
